# Runtime
PORT=8080

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DATABASE=bloodmatch

# JWT
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=bloodmatch-api

# API Google Maps
GOOGLE_MAPS_API_KEY=key-geocoding

# Spring Mail (Gmail SMTP)
GMAIL_USERNAME=google-account
GMAIL_PASSWORD=google-app-password-16-characters